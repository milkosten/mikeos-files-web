# mikeos-files-web — BFF environment (all but COOKIE_SECRET have sane defaults)
PORT=8075
ISSUER=https://account.osmike.com
CLIENT_ID=files-web
# Internal container address on deploy_default (or the public files-api host)
FILES_API=http://mikeos-files:8000
# REQUIRED in prod: stable secret so signed session cookies survive restarts
COOKIE_SECRET=change-me
# Persist sessions across redeploys (path inside the container volume)
SESSIONS_FILE=/data/sessions.json
